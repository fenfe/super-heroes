<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hero Vault | All-Time SuperHeroes</title>
    <!-- Google Fonts: Bangers for comic titles + Space Grotesk for crisp UI -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="top-banner">
        <div class="banner-inner">
            <!-- <span class="badge-issue">ISSUE #01 • ALL-TIME ARCHIVES</span> -->
            <h1>⚡ HERO-VAULT</h1>
            <p>Recruit, upgrade, and manage Earth’s mightiest legends of all time.</p>
        </div>
    </header>

    <div class="main-section">
        <!-- LEFT COLUMN: FORMS -->
        <div class="left">

            <!-- CREATE FORM -->
            <form action="/addHero" method="POST" class="comic-panel panel-create">
                <div class="panel-tag tag-yellow">NEW RECRUIT</div>
                <h3>Create a Hero</h3>
                <input class="inputs" type="text" name="heroName" placeholder="Hero Name (e.g. Spider-Man)" required>
                <input class="inputs" type="text" name="alterEgo" placeholder="Alter Ego (e.g. Peter Parker)">
                <input class="inputs" type="text" name="powers" placeholder="Powers (e.g. Web-slinging, Wall-crawling)">
                <input class="inputs" type="text" name="movie" placeholder="Debut Movie">
                <button class="btn-comic btn-create" type="submit">+ Add to Roster</button>
            </form>

            <!-- UPDATE FORM -->
            <form action="/updateHero?_method=PUT" method="POST" class="comic-panel panel-update" id="updateForm">
                <div class="panel-tag tag-cyan">POWER UP</div>
                <h3>Update Hero</h3>
                <p class="helper-text">Click <strong>"Edit"</strong> on any hero card to auto-fill their ID, or paste it below:</p>
                
                <input class="inputs id-input" type="text" id="updateId" name="id" placeholder="MongoDB Hero ID" required>
                <input class="inputs" type="text" id="updateName" name="heroName" placeholder="New Hero Name">
                <input class="inputs" type="text" id="updateAlterEgo" name="alterEgo" placeholder="New Alter Ego">
                <input class="inputs" type="text" id="updatePowers" name="powers" placeholder="New Powers">
                <input class="inputs" type="text" id="updateMovie" name="movie" placeholder="New Debut Movie">
                <button class="btn-comic btn-update" type="submit">⚡ Save Changes</button>
            </form>

        </div>

        <!-- RIGHT COLUMN: HERO ROSTER -->
        <div class="right comic-panel panel-roster">
            <div class="roster-header">
                <h2>Wall Of Heroes</h2>
                <span class="hero-count"><%= heroes.length %> Active</span>
            </div>

            <% if (heroes.length === 0) { %>
                <div class="empty-state">
                    <h3>No Heroes Found!</h3>
                    <p>The city needs a savior. Use the form on the left to create your first superhero!</p>
                </div>
            <% } %>

            <ul class="heroes">
                <% for(let i = 0; i < heroes.length; i++) { %>
                    <li class="hero">
                        <div class="hero-card-top">
                            <h3><%= heroes[i].heroName %></h3>
                            <span class="debut-badge">🎬 <%= heroes[i].movie || 'Comic Origin' %></span>
                        </div>
                        
                        <div class="hero-details">
                            <p><span class="label">Alter Ego:</span> <%= heroes[i].alterEgo || 'Classified' %></p>
                            <p><span class="label">Powers:</span> <%= heroes[i].powers || 'Unknown Abilities' %></p>
                        </div>

                        <div class="hero-id" title="MongoDB Document ID">
                            ID: <%= heroes[i]._id %>
                        </div>

                        <div class="card-actions">
                            <!-- Auto-fills the Update form without page reload -->
                            <button type="button" class="btn-small btn-edit" 
                                onclick="fillUpdateForm(
                                    '<%= heroes[i]._id %>', 
                                    `<%= heroes[i].heroName %>`, 
                                    `<%= heroes[i].alterEgo || '' %>`, 
                                    `<%= heroes[i].powers || '' %>`, 
                                    `<%= heroes[i].movie || '' %>`
                                )">
                                ✏️ Edit
                            </button>

                            <!-- One-Click Delete with confirmation -->
                            <form action="/deleteHero?_method=DELETE" method="POST" class="inline-delete-form" onsubmit="return confirm('Retire <%= heroes[i].heroName %> from the roster?');">
                                <input type="hidden" name="id" value="<%= heroes[i]._id %>">
                                <button type="submit" class="btn-small btn-card-delete">🗑️ Delete</button>
                            </form>
                        </div>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>

    <!-- Tiny helper script so users don't have to manually copy-paste MongoDB IDs -->
    <script src="/main.js"> </script>
</body>
</html>
